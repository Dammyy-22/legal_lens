diff --git a/database/tests/user_consent_test.sql b/database/tests/user_consent_test.sql
new file mode 100644
index 0000000..47c5b90
--- /dev/null
+++ b/database/tests/user_consent_test.sql
@@ -0,0 +1,75 @@
+-- Two-user authorization tests for user_consent_events (run in CI; ON_ERROR_STOP).
+-- Uses the Supabase-style JWT claim setting that auth.uid() reads.
+\set ON_ERROR_STOP on
+begin;
+
+insert into auth.users (id, email) values
+  ('00000000-0000-0000-0000-0000000000a1', 'alice@example.test'),
+  ('00000000-0000-0000-0000-0000000000b2', 'bob@example.test');
+
+create or replace function pg_temp.as_user(uid text) returns void language plpgsql as $$
+begin
+  perform set_config('request.jwt.claim.sub', uid, true);
+end $$;
+
+create or replace function pg_temp.expect_error(stmt text, label text) returns void language plpgsql as $$
+begin
+  begin
+    execute stmt;
+  exception when others then
+    return;
+  end;
+  raise exception 'EXPECTED ERROR BUT SUCCEEDED: %', label;
+end $$;
+
+create or replace function pg_temp.assert_true(cond boolean, label text) returns void language plpgsql as $$
+begin
+  if cond is not true then raise exception 'ASSERTION FAILED: %', label; end if;
+end $$;
+
+
+-- ---------- Alice ----------
+set local role authenticated;
+select pg_temp.as_user('00000000-0000-0000-0000-0000000000a1');
+
+select pg_temp.assert_true(not public.has_current_consent('private_document_processing', 'v1'), 'no consent before granting');
+select public.grant_consent('private_document_processing', 'v1');
+select pg_temp.assert_true(public.has_current_consent('private_document_processing', 'v1'), 'granted v1 is current');
+select pg_temp.assert_true(not public.has_current_consent('private_document_processing', 'v2'), 'older version is not current for v2');
+select pg_temp.assert_true(not public.has_current_consent('drafting_assistance', 'v1'), 'purposes are independent');
+
+select public.withdraw_consent('private_document_processing');
+select pg_temp.assert_true(not public.has_current_consent('private_document_processing', 'v1'), 'withdrawn consent is not current');
+select public.grant_consent('private_document_processing', 'v1');
+select pg_temp.assert_true(public.has_current_consent('private_document_processing', 'v1'), 're-grant works');
+
+-- Direct writes are refused
+select pg_temp.expect_error($$insert into public.user_consent_events (user_id, purpose, action, policy_version) values ('00000000-0000-0000-0000-0000000000a1','drafting_assistance','granted','v1')$$, 'direct insert');
+select pg_temp.expect_error($$update public.user_consent_events set action = 'granted'$$, 'direct update');
+select pg_temp.expect_error($$delete from public.user_consent_events$$, 'direct delete');
+-- Invalid purpose is refused
+select pg_temp.expect_error($$select public.grant_consent('anything_else', 'v1')$$, 'invalid purpose');
+
+select pg_temp.assert_true((select count(*) from public.user_consent_events) = 3, 'alice sees exactly her 3 events');
+
+-- ---------- Bob must not see or inherit Alice''s consent ----------
+select pg_temp.as_user('00000000-0000-0000-0000-0000000000b2');
+select pg_temp.assert_true((select count(*) from public.user_consent_events) = 0, 'bob sees none of alice''s events');
+select pg_temp.assert_true(not public.has_current_consent('private_document_processing', 'v1'), 'bob has no consent');
+select public.withdraw_consent('private_document_processing');  -- bob withdrawing must not affect alice
+select pg_temp.as_user('00000000-0000-0000-0000-0000000000a1');
+select pg_temp.assert_true(public.has_current_consent('private_document_processing', 'v1'), 'alice unaffected by bob');
+
+-- ---------- Unauthenticated ----------
+select pg_temp.as_user('');
+select pg_temp.expect_error($$select public.grant_consent('drafting_assistance', 'v1')$$, 'grant without auth');
+select pg_temp.assert_true(not public.has_current_consent('private_document_processing', 'v1'), 'no auth => no consent');
+
+-- ---------- anon role has no access ----------
+reset role;
+set local role anon;
+select pg_temp.expect_error($$select public.grant_consent('drafting_assistance', 'v1')$$, 'anon grant');
+select pg_temp.expect_error($$select * from public.user_consent_events$$, 'anon select');
+
+rollback;
+\echo user_consent_test: all assertions passed
diff --git a/database/user_consent_migration.sql b/database/user_consent_migration.sql
new file mode 100644
index 0000000..b407913
--- /dev/null
+++ b/database/user_consent_migration.sql
@@ -0,0 +1,102 @@
+-- Server-side record of user consent to AI processing (issue LL-020).
+--
+-- Append-only event log: consent is whatever the user's LATEST event (highest seq)
+-- for a purpose says. Users can read their own events; they can write ONLY through
+-- grant_consent / withdraw_consent. Re-runnable. Rollback:
+-- database/rollbacks/user_consent_rollback.sql
+--
+-- Purposes:
+--   private_document_processing  uploading/indexing/asking about a private document
+--   drafting_assistance          sending a user's description to the drafting model
+
+create table if not exists public.user_consent_events (
+    id uuid primary key default gen_random_uuid(),
+    -- Monotonic ordering key: timestamps can tie within one transaction, so the
+    -- "latest event" is decided by seq, never by created_at.
+    seq bigint generated always as identity,
+    user_id uuid not null references auth.users(id) on delete cascade,
+    purpose text not null check (purpose in ('private_document_processing', 'drafting_assistance')),
+    action text not null check (action in ('granted', 'withdrawn')),
+    policy_version text not null check (length(policy_version) between 1 and 64),
+    created_at timestamptz not null default now()
+);
+
+create index if not exists user_consent_events_latest_idx
+    on public.user_consent_events (user_id, purpose, seq desc);
+
+alter table public.user_consent_events enable row level security;
+
+revoke all on public.user_consent_events from public, anon, authenticated;
+grant select on public.user_consent_events to authenticated;
+grant all on public.user_consent_events to service_role;
+
+drop policy if exists "Users read their own consent events" on public.user_consent_events;
+create policy "Users read their own consent events"
+    on public.user_consent_events
+    for select
+    to authenticated
+    using (user_id = auth.uid());
+-- No insert/update/delete policies: events are written only by the functions below
+-- and can never be edited or removed by the user (audit integrity).
+
+create or replace function public.grant_consent(p_purpose text, p_policy_version text)
+returns void
+language plpgsql
+security definer
+set search_path = public
+as $$
+begin
+    if auth.uid() is null then
+        raise exception 'Authentication required' using errcode = '28000';
+    end if;
+    insert into public.user_consent_events (user_id, purpose, action, policy_version)
+    values (auth.uid(), p_purpose, 'granted', p_policy_version);
+end;
+$$;
+
+create or replace function public.withdraw_consent(p_purpose text)
+returns void
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+    v_version text;
+begin
+    if auth.uid() is null then
+        raise exception 'Authentication required' using errcode = '28000';
+    end if;
+    select policy_version into v_version
+    from public.user_consent_events
+    where user_id = auth.uid() and purpose = p_purpose
+    order by seq desc
+    limit 1;
+    insert into public.user_consent_events (user_id, purpose, action, policy_version)
+    values (auth.uid(), p_purpose, 'withdrawn', coalesce(v_version, 'none'));
+end;
+$$;
+
+-- True only if the caller's latest event for the purpose is a grant of exactly
+-- the required policy version. Runs as the caller, so RLS limits it to their rows.
+create or replace function public.has_current_consent(p_purpose text, p_policy_version text)
+returns boolean
+language sql
+stable
+security invoker
+set search_path = public
+as $$
+    select coalesce((
+        select e.action = 'granted' and e.policy_version = p_policy_version
+        from public.user_consent_events e
+        where e.user_id = auth.uid() and e.purpose = p_purpose
+        order by e.seq desc
+        limit 1
+    ), false)
+$$;
+
+revoke all on function public.grant_consent(text, text) from public, anon;
+revoke all on function public.withdraw_consent(text) from public, anon;
+revoke all on function public.has_current_consent(text, text) from public, anon;
+grant execute on function public.grant_consent(text, text) to authenticated;
+grant execute on function public.withdraw_consent(text) to authenticated;
+grant execute on function public.has_current_consent(text, text) to authenticated;
