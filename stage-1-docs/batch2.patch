diff --git a/apps/web/components/ConsentSettings.tsx b/apps/web/components/ConsentSettings.tsx
new file mode 100644
index 0000000..0024e50
--- /dev/null
+++ b/apps/web/components/ConsentSettings.tsx
@@ -0,0 +1,105 @@
+'use client'
+
+import { useCallback, useEffect, useState } from 'react'
+import {
+  CONSENT_PURPOSES,
+  hasCurrentConsent,
+  withdrawConsent,
+  type ConsentPurpose,
+} from '@/lib/consent'
+
+const ROWS: { purpose: ConsentPurpose; title: string; description: string }[] = [
+  {
+    purpose: CONSENT_PURPOSES.privateDocuments,
+    title: 'Private document processing',
+    description:
+      'Lets us index your uploaded documents and answer questions about them using an AI model.',
+  },
+  {
+    purpose: CONSENT_PURPOSES.drafting,
+    title: 'Drafting assistant',
+    description: 'Lets us send the description you type to an AI model to prepare a draft.',
+  },
+]
+
+export default function ConsentSettings() {
+  const [granted, setGranted] = useState<Record<string, boolean | null>>({})
+  const [busy, setBusy] = useState<string | null>(null)
+  const [error, setError] = useState('')
+
+  const refresh = useCallback(async () => {
+    const entries = await Promise.all(
+      ROWS.map(async (row) => [row.purpose, await hasCurrentConsent(row.purpose)] as const),
+    )
+    setGranted(Object.fromEntries(entries))
+  }, [])
+
+  useEffect(() => {
+    let active = true
+    Promise.all(ROWS.map(async (row) => [row.purpose, await hasCurrentConsent(row.purpose)] as const))
+      .then((entries) => {
+        if (active) setGranted(Object.fromEntries(entries))
+      })
+      .catch(() => {
+        if (active) setError('Unable to load your consent settings.')
+      })
+    return () => {
+      active = false
+    }
+  }, [])
+
+  async function handleWithdraw(purpose: ConsentPurpose) {
+    setBusy(purpose)
+    setError('')
+    try {
+      await withdrawConsent(purpose)
+      await refresh()
+    } catch (withdrawError) {
+      setError(withdrawError instanceof Error ? withdrawError.message : 'Unable to withdraw consent.')
+    } finally {
+      setBusy(null)
+    }
+  }
+
+  return (
+    <section className="bg-white/90 border border-ink-100 rounded-2xl p-6 mt-6">
+      <h2 className="font-display text-lg text-ink mb-1">AI processing consent</h2>
+      <p className="text-ink-400 text-sm mb-4">
+        You give consent when you first upload a document or use the drafting assistant. Withdrawing it
+        stops further processing straight away. It does not delete documents you already uploaded; delete
+        those from the Documents page.
+      </p>
+      {error && (
+        <p role="alert" className="mb-3 text-sm text-seal">
+          {error}
+        </p>
+      )}
+      <ul className="space-y-4">
+        {ROWS.map((row) => (
+          <li key={row.purpose} className="flex items-start justify-between gap-4 text-sm">
+            <div>
+              <p className="text-ink font-medium">{row.title}</p>
+              <p className="text-ink-400">{row.description}</p>
+              <p className="text-ink-400 mt-1">
+                Status:{' '}
+                {granted[row.purpose] === undefined
+                  ? 'checking…'
+                  : granted[row.purpose]
+                    ? 'consent given'
+                    : 'no current consent'}
+              </p>
+            </div>
+            <button
+              type="button"
+              onClick={() => handleWithdraw(row.purpose)}
+              disabled={busy !== null || granted[row.purpose] !== true}
+              className="shrink-0 px-4 py-2 border border-seal/30 text-seal font-medium rounded-lg hover:bg-seal/5 disabled:opacity-50 transition-colors text-sm"
+            >
+              {busy === row.purpose ? 'Withdrawing…' : 'Withdraw'}
+            </button>
+          </li>
+        ))}
+      </ul>
+    </section>
+  )
+}
diff --git a/apps/web/lib/consent.ts b/apps/web/lib/consent.ts
new file mode 100644
index 0000000..d5ae063
--- /dev/null
+++ b/apps/web/lib/consent.ts
@@ -0,0 +1,47 @@
+import { createClient } from '@/lib/supabase/client'
+
+// MUST equal CONSENT_POLICY_VERSION in supabase/functions/_shared/consent.mjs
+// (a test there fails if they drift). Bump when the consent wording changes;
+// everyone is then asked again because the server only accepts the current version.
+export const CONSENT_POLICY_VERSION = '2026-11-v1'
+
+export type ConsentPurpose = 'private_document_processing' | 'drafting_assistance'
+
+export const CONSENT_PURPOSES: Record<string, ConsentPurpose> = {
+  privateDocuments: 'private_document_processing',
+  drafting: 'drafting_assistance',
+}
+
+// Records the user's consent on the server (append-only audit log). The Edge
+// Functions refuse to process content unless this has been recorded.
+export async function recordConsent(purpose: ConsentPurpose): Promise<void> {
+  const supabase = createClient()
+  const { error } = await supabase.rpc('grant_consent', {
+    p_purpose: purpose,
+    p_policy_version: CONSENT_POLICY_VERSION,
+  })
+  if (error) throw new Error('We could not record your consent. Please try again.')
+}
+
+// Records consent only if there is no current consent yet, so the audit log is
+// not filled with a new event on every action.
+export async function ensureConsent(purpose: ConsentPurpose): Promise<void> {
+  if (await hasCurrentConsent(purpose)) return
+  await recordConsent(purpose)
+}
+
+export async function withdrawConsent(purpose: ConsentPurpose): Promise<void> {
+  const supabase = createClient()
+  const { error } = await supabase.rpc('withdraw_consent', { p_purpose: purpose })
+  if (error) throw new Error('We could not withdraw your consent. Please try again.')
+}
+
+export async function hasCurrentConsent(purpose: ConsentPurpose): Promise<boolean> {
+  const supabase = createClient()
+  const { data, error } = await supabase.rpc('has_current_consent', {
+    p_purpose: purpose,
+    p_policy_version: CONSENT_POLICY_VERSION,
+  })
+  if (error) return false
+  return data === true
+}
