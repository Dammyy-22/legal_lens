-          grant select, insert, update, delete on storage.objects to authenticated, service_role;
-          alter table storage.objects enable row level security;
-          SQL
+      - name: Stub Supabase-managed schemas and roles (real Supabase has these built in)
+        run: PGPASSWORD=postgres psql -h localhost -U postgres -d legalens -v ON_ERROR_STOP=1 -f database/ci/supabase_stub.sql
       - name: Apply schema.sql
         run: PGPASSWORD=postgres psql -h localhost -U postgres -d legalens -v ON_ERROR_STOP=1 -f database/schema.sql
       - name: Apply user document migration
         run: PGPASSWORD=postgres psql -h localhost -U postgres -d legalens -v ON_ERROR_STOP=1 -f database/user_documents_migration.sql
       - name: Verify user document migration is rerunnable
         run: PGPASSWORD=postgres psql -h localhost -U postgres -d legalens -v ON_ERROR_STOP=1 -f database/user_documents_migration.sql
+      - name: Apply waitlist migration
+        run: PGPASSWORD=postgres psql -h localhost -U postgres -d legalens -v ON_ERROR_STOP=1 -f database/waitlist_migration.sql
+      - name: Apply matter management migration
+        run: PGPASSWORD=postgres psql -h localhost -U postgres -d legalens -v ON_ERROR_STOP=1 -f database/matter_management_migration.sql
+      - name: Apply lexical search migration
+        run: PGPASSWORD=postgres psql -h localhost -U postgres -d legalens -v ON_ERROR_STOP=1 -f database/lexical_search_migration.sql
+      - name: Verify matter and lexical migrations are rerunnable
