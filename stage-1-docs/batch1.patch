new file mode 100644
index 0000000..466eec3
--- /dev/null
+++ b/.github/dependabot.yml
@@ -0,0 +1,20 @@
+version: 2
+updates:
+  - package-ecosystem: npm
+    directory: /apps/web
+    schedule:
+      interval: weekly
+    open-pull-requests-limit: 5
+  - package-ecosystem: npm
+    directory: /scripts/ingestion
+    schedule:
+      interval: weekly
+    open-pull-requests-limit: 3
+  - package-ecosystem: pip
+    directory: /services/unlimited-ocr-gateway
+    schedule:
+      interval: weekly
+  - package-ecosystem: github-actions
+    directory: /
+    schedule:
+      interval: weekly
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index bfcbc99..0d3e5ba 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -16,6 +16,12 @@ jobs:
       - name: Install dependencies
         working-directory: apps/web
         run: npm ci
+      - name: Lint
+        working-directory: apps/web
+        run: npm run lint
+      - name: Audit production dependencies
+        working-directory: apps/web
+        run: npm audit --omit=dev --audit-level=high
       - name: Build
         working-directory: apps/web
         run: npx next build
@@ -33,6 +39,9 @@ jobs:
       - name: Type-check legal function
         working-directory: supabase/functions/legal
         run: deno check index.ts
+      - name: Type-check draft-document function
+        working-directory: supabase/functions/draft-document
+        run: deno check index.ts
       - name: Type-check private document functions
         run: |
           deno check supabase/functions/create-user-document-upload/index.ts
@@ -48,10 +57,37 @@ jobs:
           node-version: "22"
       - name: Test document processing and Q&A logic
         run: |
+          node --test supabase/functions/ask/logic.test.mjs
+          node --test supabase/functions/_shared/openrouter-policy.test.mjs
           node --test supabase/functions/process-user-document/logic.test.mjs
           node --test supabase/functions/ask-user-document/logic.test.mjs
           node --test scripts/ingestion/constitution-structure.test.mjs
 
+  ocr-gateway-tests:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+      - name: Install gateway requirements
+        working-directory: services/unlimited-ocr-gateway
+        run: pip install -r requirements.txt
+      - name: Test OCR gateway
+        working-directory: services/unlimited-ocr-gateway
+        run: python -m unittest test_gateway
+
+  secret-scan:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+      - name: Scan history for committed secrets
+        uses: gitleaks/gitleaks-action@v2
+        env:
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+
