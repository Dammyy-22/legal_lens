+          PGPASSWORD=postgres psql -h localhost -U postgres -d legalens -v ON_ERROR_STOP=1 -f database/lexical_search_migration.sql
diff --git a/apps/web/eslint.config.mjs b/apps/web/eslint.config.mjs
new file mode 100644
index 0000000..a01dbec
--- /dev/null
+++ b/apps/web/eslint.config.mjs
@@ -0,0 +1,19 @@
+import nextCoreWebVitals from 'eslint-config-next/core-web-vitals'
+import nextTypescript from 'eslint-config-next/typescript'
+
+const config = [
+  { ignores: ['.next/**', 'node_modules/**', 'next-env.d.ts'] },
+  ...nextCoreWebVitals,
+  ...nextTypescript,
+  {
+    // LL-050: these React 19-era rules flag 6 existing components. They are kept
+    // visible as warnings so CI can gate on real errors; fixing them is a UI
+    // refactor outside Batch 1. Promote back to "error" once resolved.
+    rules: {
+      'react-hooks/set-state-in-effect': 'warn',
+      'react-hooks/immutability': 'warn',
+    },
+  },
+]
+
+export default config
