# Supabase project settings — find these in Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Never put the service_role key here or in any NEXT_PUBLIC_ variable — it must only
# ever be used server-side (e.g. in a future admin API route), never shipped to the
# browser. The FastAPI backend, if kept for non-auth features, would use its own
# server-side .env, never this file.
