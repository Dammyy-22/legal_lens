# Copy this file to .env and replace every placeholder.
# This file is server-only. Never use these values in NEXT_PUBLIC_* variables.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
OPENAI_API_KEY=your-openai-api-key

# Set true when OpenAI credits are unavailable. Text search still works, but semantic
# vector retrieval is disabled until embeddings are generated.
SKIP_EMBEDDINGS=false

# Optional: override the default ../../legal corpus folder.
# CORPUS_DIR=C:\path\to\legal corpus