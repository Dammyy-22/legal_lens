{
    "name": "legalens-ingestion",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node node_modules/typescript/bin/tsc --noEmit false --outDir dist --module NodeNext --moduleResolution NodeNext --target ES2022 --esModuleInterop --skipLibCheck --types node && node -e \"require('node:fs').copyFileSync('constitution-structure.mjs', 'dist/constitution-structure.mjs')\"",
        "ingest:constitution": "npm run build && node dist/ingest-constitution.js",
        "ingest:corpus": "npm run build && node dist/ingest-corpus.js",
        "test:constitution": "node --test constitution-structure.test.mjs"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.45.4",
        "dotenv": "^16.4.7",
        "openai": "^4.63.0",
        "pdf-parse": "^1.1.1"
    },
    "devDependencies": {
        "@types/node": "^20.14.0",
        "@types/pdf-parse": "^1.1.5",
        "tsx": "^4.19.1",
        "typescript": "^5.5.4"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
