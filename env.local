# Copy to .env and fill in real values. Never commit .env.

APP_NAME=legalens-api
APP_ENV=development
APP_DEBUG=true

# Postgres (docker-compose service name "db" when running via compose; localhost for
# bare-metal local dev)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/legalens

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth — generate a real random secret, e.g. `openssl rand -hex 32`. NEVER reuse this
# placeholder value anywhere beyond local dev.
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Embeddings — must match whatever embedding model is selected in Phase 8. Changing this
# after data is embedded requires a re-embedding migration, not just a config change.
EMBEDDING_DIM=1536

# AI provider credentials — added when Phase 8/10 selects a provider. Placeholder only.
# AI_PROVIDER_API_KEY=

# S3-compatible object storage — added when Phase 6/16 wires up ingestion/uploads.
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
